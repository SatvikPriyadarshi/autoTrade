MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Demo
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# Session hours (UTC)
LONDON_SESSION_UTC=7-11
NY_SESSION_UTC=12-21

# MT5 connection
MT5_INIT_RETRIES=5
MT5_INIT_RETRY_DELAY_SEC=3
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Risk management
RISK_PCT=1.0
MAX_DAILY_LOSS_USD=100
MAX_DAILY_LOSS_PCT=3.0
MAX_RISK_PER_TRADE_PERCENT=0.75
MAX_RISK_PER_TRADE_USD=20
MAX_TRADE_LOSS_USD=20
MAX_TRADES_DAY=10
MAX_TRADES_PER_SYMBOL_PER_DAY=3
SYMBOL_COOLDOWN_MIN=10
LOSS_COOLDOWN_MIN=30
MAX_CONSECUTIVE_LOSSES=3
MAX_TRADE_DURATION_MIN=880

# SL/TP and quality constraints
MIN_RR_RATIO=2.5
ALGO_MIN_RR_FLOOR=2.5
ALGO_MAX_SL_ATR=2.2
ALGO_MIN_SL_ATR=0.5
ALGO_MAX_SL_PIPS=120
ALGO_FIB_OTE_REQUIRED=false
ALGO_FIB_OTE_LOW=0.62
ALGO_FIB_OTE_HIGH=0.79

# Position management
PARTIAL_TP_ENABLED=true
PARTIAL_TP_TRIGGER_RR=2.0
PARTIAL_TP_PERCENTAGE=0.5
PARTIAL_TP_MIN_LOT=0.02
BREAKEVEN_TRIGGER_RR=1.0
BREAKEVEN_BUFFER_PIPS=2
TRAIL_TRIGGER_RR=2.0
TRAIL_STEP_RATIO=0.9
TRAIL_LOCK_RR=1.2
TRAIL_MIN_MOVE_PIPS=3
TRAIL_UPDATE_COOLDOWN_SEC=120

# Volume confirmation for BE
VOLUME_CONFIRMATION_ENABLED=true
VOLUME_CONFIRMATION_MIN_RATIO=1.0

# Pure algo confirmations (no AI)
PURE_ALGO_MODE=true
ALGO_REQUIRE_M5_CONFIRM=true
ALGO_REQUIRE_MTF_CONFIRM=true
ALGO_MTF_MIN_CONFIDENCE=70
ALGO_MIN_POI_CONFLUENCE=2
ALGO_REQUIRE_M15_EMA_ALIGN=true
ALGO_LIQUIDITY_SHORTCUT=false

# POI reach tuning
ALGO_VOLUME_MIN_RATIO=0.5
ALGO_POI_ATR_MULT=0.35
ALGO_POI_EXTRA_PIPS=3

# News filter
NEWS_FILTER_ENABLED=true
NEWS_BLACKOUT_MINUTES=30
