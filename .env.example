MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Demo
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# Session hours (UTC)
LONDON_SESSION_UTC=7-11
NY_SESSION_UTC=12-21

# MT5 connection
MT5_INIT_RETRIES=5
MT5_INIT_RETRY_DELAY_SEC=3
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Risk management
MAX_DAILY_LOSS_USD=100
MAX_RISK_PER_TRADE_USD=20
MAX_TRADE_LOSS_USD=50  # Absolute maximum loss per trade (hard stop)
SYMBOL_COOLDOWN_MIN=10
LOSS_COOLDOWN_MIN=30
MAX_TRADES_PER_SYMBOL_PER_DAY=3
MAX_CONSECUTIVE_LOSSES=3
MAX_TRADE_DURATION_MIN=480  # 8 hours maximum trade duration

# Position management
PARTIAL_TP_ENABLED=true  # Enable partial take-profit (close 50% at 1R)
PARTIAL_TP_TRIGGER_RR=1.0  # Close partial at 1R profit
PARTIAL_TP_PERCENTAGE=0.5  # Close 50% of position
PARTIAL_TP_MIN_LOT=0.02  # Minimum lot size for partial TP

# News filter
NEWS_FILTER_ENABLED=true
NEWS_BLACKOUT_MINUTES=30
